': 5, 'Love': 15, 'Boredom': 0, 'Neutral': 45}, 'text': 'I do not. But my job is at a gym so it is nice to meet people .'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 5, 'Joy': 25, 'Sadness': 15, 'Surprise': 5, 'Love': 15, 'Boredom': 0, 'Neutral': 35}, 'text': 'Where are you? 🙈'}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 5, 'Joy': 15, 'Sadness': 10, 'Surprise': 5, 'Love': 15, 'Boredom': 0, 'Neutral': 50}, 'text': 'I am here'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 5, 'Joy': 15, 'Sadness': 25, 'Surprise': 5, 'Love': 15, 'Boredom': 0, 'Neutral': 35}, 'text': 'I am not working out .'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 5, 'Joy': 20, 'Sadness': 25, 'Surprise': 5, 'Love': 15, 'Boredom': 0, 'Neutral': 30}, 'text': 'Hey, are you alive there? 😱'}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 5, 'Joy': 15, 'Sadness': 20, 'Surprise': 5, 'Love': 15, 'Boredom': 0, 'Neutral': 40}, 'text': 'I like to swim'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 5, 'Joy': 15, 'Sadness': 30, 'Surprise': 5, 'Love': 20, 'Boredom': 0, 'Neutral': 25}, 'text': "Don't make me sad 😞\nSay something!"}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 5, 'Joy': 15, 'Sadness': 25, 'Surprise': 5, 'Love': 20, 'Boredom': 0, 'Neutral': 30}, 'text': 'I swim in the gym so that is how we can do that'}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 5, 'Joy': 20, 'Sadness': 10, 'Surprise': 5, 'Love': 15, 'Boredom': 0, 'Neutral': 45}, 'text': 'Do you like pizza?'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 5, 'Joy': 20, 'Sadness': 15, 'Surprise': 5, 'Love': 25, 'Boredom': 0, 'Neutral': 30}, 'text': 'I love pizza, but my favorite food is burger .'}}, {'role': 'participant_1', 'content': {'emotion_s