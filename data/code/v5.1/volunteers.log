': 'participant_1', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 20, 'Sadness': 0, 'Surprise': 5, 'Love': 25, 'Boredom': 0, 'Neutral': 50}, 'text': 'If you love art then there are so many great cities to visit. I recommend Rome.'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 25, 'Sadness': 0, 'Surprise': 5, 'Love': 35, 'Boredom': 0, 'Neutral': 35}, 'text': 'I love rome. do you like'}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 15, 'Sadness': 0, 'Surprise': 5, 'Love': 20, 'Boredom': 0, 'Neutral': 60}, 'text': "Yes it's great except it can be crowded."}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 20, 'Sadness': 0, 'Surprise': 5, 'Love': 25, 'Boredom': 0, 'Neutral': 50}, 'text': 'it is. do you like'}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 20, 'Sadness': 0, 'Surprise': 5, 'Love': 15, 'Boredom': 0, 'Neutral': 60}, 'text': 'Ok nice to chat with you but I have to go now!  Bye!'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 20, 'Sadness': 0, 'Surprise': 5, 'Love': 25, 'Boredom': 0, 'Neutral': 50}, 'text': 'what are you going to do for a living? I like art and chips'}}]}
