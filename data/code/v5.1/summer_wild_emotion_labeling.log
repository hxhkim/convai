tion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 15, 'Sadness': 25, 'Surprise': 5, 'Love': 0, 'Boredom': 10, 'Neutral': 45}, 'text': 'Teachers?'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 15, 'Sadness': 20, 'Surprise': 5, 'Love': 0, 'Boredom': 5, 'Neutral': 55}, 'text': 'very wealthy bankers, funny you :)'}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 10, 'Sadness': 20, 'Surprise': 5, 'Love': 0, 'Boredom': 5, 'Neutral': 60}, 'text': 'Oh'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 15, 'Sadness': 20, 'Surprise': 5, 'Love': 0, 'Boredom': 5, 'Neutral': 55}, 'text': "yeah , and i've played it since the age of four ."}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 10, 'Sadness': 15, 'Surprise': 5, 'Love': 0, 'Boredom': 10, 'Neutral': 60}, 'text': 'Played what?'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 15, 'Sadness': 25, 'Surprise': 5, 'Love': 0, 'Boredom': 10, 'Neutral': 45}, 'text': 'nothing big time yet , i still have to work full time to pay the bills .'}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 20, 'Sadness': 10, 'Surprise': 5, 'Love': 0, 'Boredom': 5, 'Neutral': 60}, 'text': 'Speak of playing, do you like board games?'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 15, 'Sadness': 30, 'Surprise': 5, 'Love': 0, 'Boredom': 10, 'Neutral': 40}, 'text': 'i do not really have time between the other stuff and my volunteer job 🧐'}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 15, 'Sadness': 25, 'Surprise': 5, 'Love': 0, 'Boredom': 10, 'Neutral': 45}, 'text': 'Sure A lot of jobs you have'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 10, 'Sadness': 15, 'Surprise': 5, 'Love': 0, 'Boredom': 10, 'Neutral': 60}, 'text': 'do you smoke or drink ?'}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 15, 'Sadness': 25, 'Surprise': 5, 'Love': 0, 'Boredom': 10, 'Neutral': 45}, 'text': 'I’m a moderate drinker andI don’t smoke. Do you smoke?'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 20, 'Sadness': 20, 'Surprise': 10, 'Love': 0, 'Boredom': 10, 'Neutral': 40}, 'text': 'howdy i am a baseball player'}}]}
