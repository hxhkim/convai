': {'emotion_scores': {'Anger': 35, 'Fear': 10, 'Joy': 0, 'Sadness': 20, 'Surprise': 5, 'Love': 15, 'Boredom': 0, 'Neutral': 15}, 'text': 'Oh, Jesus! I feel like a whore in a Catholic church!'}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 30, 'Fear': 10, 'Joy': 0, 'Sadness': 20, 'Surprise': 5, 'Love': 15, 'Boredom': 0, 'Neutral': 20}, 'text': 'Dude. Stop it'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 35, 'Fear': 10, 'Joy': 0, 'Sadness': 20, 'Surprise': 5, 'Love': 15, 'Boredom': 0, 'Neutral': 15}, 'text': "Okay. God, I'm really kicking your ass."}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 30, 'Fear': 5, 'Joy': 0, 'Sadness': 20, 'Surprise': 5, 'Love': 15, 'Boredom': 0, 'Neutral': 25}, 'text': 'You are so rude'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 35, 'Fear': 10, 'Joy': 0, 'Sadness': 20, 'Surprise': 5, 'Love': 15, 'Boredom': 0, 'Neutral': 15}, 'text': "No!  You don't behave, you go in the bad girl closet."}}, {'role': 'participant_1', 'content': {'emotion_scores': {}, 'text': "I'm just a little girl"}}, {'role': 'participant_2', 'content': {'emotion_scores': {}, 'text': "No! Sometimes I'm jealous of me."}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 25, 'Fear': 10, 'Joy': 5, 'Sadness': 20, 'Surprise': 5, 'Love': 15, 'Boredom': 5, 'Neutral': 15}, 'text': 'Okay, bye'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 35, 'Fear': 10, 'Joy': 0, 'Sadness': 25, 'Surprise': 5, 'Love': 15, 'Boredom': 0, 'Neutral': 10}, 'text': "'Cause Janny Boo is driving me nuts!"}}]}
