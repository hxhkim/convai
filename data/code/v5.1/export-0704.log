ion_scores': {'Anger': 0, 'Fear': 10, 'Joy': 5, 'Sadness': 40, 'Surprise': 5, 'Love': 10, 'Boredom': 15, 'Neutral': 15}, 'text': 'I was a doctor'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 15, 'Joy': 10, 'Sadness': 30, 'Surprise': 5, 'Love': 10, 'Boredom': 15, 'Neutral': 15}, 'text': 'i am not sure what that is . i am trying to get into it .'}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 15, 'Joy': 5, 'Sadness': 40, 'Surprise': 5, 'Love': 10, 'Boredom': 10, 'Neutral': 15}, 'text': 'You should be a doctor'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 15, 'Joy': 5, 'Sadness': 30, 'Surprise': 5, 'Love': 10, 'Boredom': 15, 'Neutral': 20}, 'text': 'i am sure . i am sure it will .'}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 15, 'Joy': 5, 'Sadness': 40, 'Surprise': 5, 'Love': 10, 'Boredom': 10, 'Neutral': 15}, 'text': 'A doctor saved me from my cancer a few years back'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 15, 'Joy': 5, 'Sadness': 30, 'Surprise': 5, 'Love': 10, 'Boredom': 15, 'Neutral': 20}, 'text': 'that is a long time . do you like it ?'}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 15, 'Joy': 5, 'Sadness': 50, 'Surprise': 5, 'Love': 10, 'Boredom': 10, 'Neutral': 5}, 'text': "It's cancer. Of course I don't like it"}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 10, 'Joy': 5, 'Sadness': 40, 'Surprise': 5, 'Love': 10, 'Boredom': 15, 'Neutral': 15}, 'text': 'i have never heard of that .'}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 15, 'Joy': 5, 'Sadness': 50, 'Surprise': 5, 'Love': 10, 'Boredom': 10, 'Neutral': 5}, 'text': "It's a sickness. A disease"}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 15, 'Joy': 5, 'Sadness': 30, 'Surprise': 5, 'Love': 10, 'Bored